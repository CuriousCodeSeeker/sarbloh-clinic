// ============================================================
// Sarbloh Ayurvedic Clinic - Database Schema
// Phase 1 Foundation
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
  OTHER
}

enum UserRole {
  ADMIN
  PRACTITIONER
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  EXPIRED
  TRANSFER
}

enum AttachmentEntityType {
  PATIENT
  VISIT
  PRESCRIPTION
  MEDICINE
  HERB
  SALE
  OTHER
}

enum SaleType {
  PRODUCT
  CONSULTANCY
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         UserRole  @default(PRACTITIONER)
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  visitsAsPractitioner        Visit[]                @relation("VisitPractitioner")
  prescriptionsAsPractitioner Prescription[]         @relation("PrescriptionPractitioner")
  appointmentsAsPractitioner  Appointment[]          @relation("AppointmentPractitioner")
  salesCreated                Sale[]                 @relation("SaleCreatedBy")
  inventoryTransactions       InventoryTransaction[]
  attachmentsUploaded         Attachment[]
  auditLogs                   AuditLog[]

  @@map("users")
}

// ============================================================
// PATIENTS
// ============================================================

model Patient {
  id                String         @id @default(uuid())
  patientCode       String         @unique @map("patient_code")
  fullName          String         @map("full_name")
  fatherHusbandName String?        @map("father_husband_name")
  dateOfBirth       DateTime?      @map("date_of_birth")
  ageAtRegistration Int?           @map("age_at_registration")
  gender            Gender?
  maritalStatus     MaritalStatus? @map("marital_status")
  referredBy        String?        @map("referred_by")
  notes             String?
  isActive          Boolean        @default(true) @map("is_active")
  deletedAt         DateTime?      @map("deleted_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

    contacts      PatientContact[]
  addresses     PatientAddress[]
  visits        Visit[]
  appointments  Appointment[]
  sales         Sale[]
  prescriptions Prescription[]

  @@index([fullName])
  @@index([patientCode])
  @@map("patients")
}

model PatientContact {
  id        String   @id @default(uuid())
  patientId String   @map("patient_id")
  type      String
  value     String
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([value])
  @@map("patient_contacts")
}

model PatientAddress {
  id          String   @id @default(uuid())
  patientId   String   @map("patient_id")
  addressLine String   @map("address_line")
  city        String?
  state       String?
  country     String?  @default("India")
  pincode     String?
  isPrimary   Boolean  @default(true) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_addresses")
}

// ============================================================
// VISITS & CLINICAL
// ============================================================

model Visit {
  id              String    @id @default(uuid())
  patientId       String    @map("patient_id")
  practitionerId  String?   @map("practitioner_id")
  visitDate       DateTime  @default(now()) @map("visit_date")
  complaint       String?
  history         String?
  treatmentAdvice String?   @map("treatment_advice")
  followUpDate    DateTime? @map("follow_up_date")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  patient       Patient        @relation(fields: [patientId], references: [id])
  practitioner  User?          @relation("VisitPractitioner", fields: [practitionerId], references: [id])
  prescriptions Prescription[]

  @@index([patientId])
  @@index([visitDate])
  @@index([followUpDate])
  @@map("visits")
}

model Prescription {
  id               String    @id @default(uuid())
  visitId          String?   @map("visit_id")
  patientId        String    @map("patient_id")
  practitionerId   String?   @map("practitioner_id")
  prescriptionDate DateTime  @default(now()) @map("prescription_date")
  notes            String?
  followUpDate     DateTime? @map("follow_up_date")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

    visit        Visit?             @relation(fields: [visitId], references: [id])
  patient      Patient            @relation(fields: [patientId], references: [id])
  practitioner User?              @relation("PrescriptionPractitioner", fields: [practitionerId], references: [id])
  items        PrescriptionItem[]

  @@index([patientId])
  @@index([prescriptionDate])
  @@map("prescriptions")
}

model PrescriptionItem {
  id              String   @id @default(uuid())
  prescriptionId  String   @map("prescription_id")
  medicineId      String?  @map("medicine_id")
  medicineName    String?  @map("medicine_name")
  dosage          String?
  frequency       String?
  duration        String?
  quantity        Decimal? @db.Decimal(10, 2)
  route           String?
  instructions    String?
  beforeAfterFood String?  @map("before_after_food")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine?    @relation(fields: [medicineId], references: [id])

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ============================================================
// MEDICINES & INVENTORY
// ============================================================

model MedicineCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent    MedicineCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  MedicineCategory[] @relation("CategoryHierarchy")
  medicines Medicine[]

  @@map("medicine_categories")
}

model Medicine {
  id            String    @id @default(uuid())
  name          String
  brand         String?
  categoryId    String?   @map("category_id")
  sku           String?   @unique
  barcode       String?
  unit          String?
  purchasePrice Decimal?  @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice  Decimal?  @map("selling_price") @db.Decimal(12, 2)
  reorderLevel  Int       @default(10) @map("reorder_level")
  minStock      Int       @default(5) @map("min_stock")
  description   String?
  imagePath     String?   @map("image_path")
  isActive      Boolean   @default(true) @map("is_active")
  isRawHerb     Boolean   @default(false) @map("is_raw_herb")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  category              MedicineCategory?      @relation(fields: [categoryId], references: [id])
  batches               MedicineBatch[]
  inventoryTransactions InventoryTransaction[]
  prescriptionItems     PrescriptionItem[]
  saleItems             SaleItem[]
  purchaseItems         PurchaseItem[]

  @@index([name])
  @@index([sku])
  @@index([barcode])
  @@map("medicines")
}

model MedicineBatch {
  id                String    @id @default(uuid())
  medicineId        String    @map("medicine_id")
  batchNumber       String    @map("batch_number")
  manufacturingDate DateTime? @map("manufacturing_date")
  expiryDate        DateTime? @map("expiry_date")
  quantity          Decimal   @default(0) @db.Decimal(12, 2)
  purchasePrice     Decimal?  @map("purchase_price") @db.Decimal(12, 2)
  supplierId        String?   @map("supplier_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  medicine Medicine  @relation(fields: [medicineId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([medicineId])
  @@index([expiryDate])
  @@map("medicine_batches")
}

model InventoryTransaction {
  id              String                   @id @default(uuid())
  medicineId      String?                  @map("medicine_id")
  herbId          String?                  @map("herb_id")
  batchId         String?                  @map("batch_id")
  transactionType InventoryTransactionType @map("transaction_type")
  quantity        Decimal                  @db.Decimal(12, 2)
  referenceType   String?                  @map("reference_type")
  referenceId     String?                  @map("reference_id")
  notes           String?
  createdById     String?                  @map("created_by_id")
  createdAt       DateTime                 @default(now()) @map("created_at")

  medicine  Medicine? @relation(fields: [medicineId], references: [id])
  herb      Herb?     @relation(fields: [herbId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@index([medicineId])
  @@index([herbId])
  @@map("inventory_transactions")
}

// ============================================================
// HERBS (Multilingual - language extensible)
// ============================================================

model Herb {
  id                String   @id @default(uuid())
  botanicalName     String?  @map("botanical_name")
  commonName        String?  @map("common_name")
  description       String?
  benefits          String?
  uses              String?
  partsUsed         String?  @map("parts_used")
  preparation       String?
  dosage            String?
  contraindications String?
  imagePath         String?  @map("image_path")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  diseaseCategories HerbDiseaseCategory[]
  inventoryTransactions InventoryTransaction[]
  names HerbName[]

  @@index([botanicalName])
  @@index([commonName])
  @@map("herbs")
}

model HerbName {
  id           String @id @default(uuid())
  herbId       String @map("herb_id")
  languageCode String @map("language_code")
  name         String

  herb Herb @relation(fields: [herbId], references: [id], onDelete: Cascade)

  @@unique([herbId, languageCode])
  @@index([name])
  @@index([languageCode])
  @@map("herb_names")
}

// ============================================================
// SUPPLIERS & PURCHASES
// ============================================================

model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchases Purchase[]
  batches   MedicineBatch[]

  @@map("suppliers")
}

model Purchase {
  id            String   @id @default(uuid())
  supplierId    String?  @map("supplier_id")
  purchaseDate  DateTime @default(now()) @map("purchase_date")
  invoiceNumber String?  @map("invoice_number")
  totalAmount   Decimal? @map("total_amount") @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  supplier Supplier?      @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id          String    @id @default(uuid())
  purchaseId  String    @map("purchase_id")
  medicineId  String    @map("medicine_id")
  quantity    Decimal   @db.Decimal(12, 2)
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 2)
  total       Decimal   @db.Decimal(12, 2)
  batchNumber String?   @map("batch_number")
  expiryDate  DateTime? @map("expiry_date")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])

  @@map("purchase_items")
}

// ============================================================
// SALES & PAYMENTS
// ============================================================

model Sale {
  id            String         @id @default(uuid())
  invoiceNumber String         @unique @map("invoice_number")
  patientId     String?        @map("patient_id")
  saleDate      DateTime       @default(now()) @map("sale_date")
  subtotal      Decimal        @default(0) @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  tax           Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal        @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueAmount     Decimal        @default(0) @map("due_amount") @db.Decimal(12, 2)
  paymentStatus PaymentStatus  @default(PENDING) @map("payment_status")
  paymentMethod PaymentMethod? @map("payment_method")
  status        SaleStatus     @default(DRAFT)
  notes         String?
  createdById   String?        @map("created_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

    saleType  SaleType  @default(PRODUCT) @map("sale_type")

  patient   Patient?   @relation(fields: [patientId], references: [id])
  createdBy User?      @relation("SaleCreatedBy", fields: [createdById], references: [id])
  items     SaleItem[]
  payments  Payment[]

  @@index([saleDate])
  @@index([paymentStatus])
  @@index([invoiceNumber])
  @@map("sales")
}

model SaleItem {
  id         String  @id @default(uuid())
  saleId     String  @map("sale_id")
  medicineId String  @map("medicine_id")
  batchId    String? @map("batch_id")
  quantity   Decimal @db.Decimal(12, 2)
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])

  @@map("sale_items")
}

model Payment {
  id             String        @id @default(uuid())
  saleId         String        @map("sale_id")
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  transactionRef String?       @map("transaction_ref")
  paidAt         DateTime      @default(now()) @map("paid_at")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("payments")
}

// ============================================================
// APPOINTMENTS
// ============================================================

model Appointment {
  id              String            @id @default(uuid())
  patientId       String            @map("patient_id")
  practitionerId  String?           @map("practitioner_id")
  appointmentDate DateTime          @map("appointment_date")
  startTime       String?           @map("start_time")
  endTime         String?           @map("end_time")
  reason          String?
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  patient      Patient @relation(fields: [patientId], references: [id])
  practitioner User?   @relation("AppointmentPractitioner", fields: [practitionerId], references: [id])

  @@index([appointmentDate])
  @@index([patientId])
  @@index([status])
  @@map("appointments")
}

// ============================================================
// ATTACHMENTS
// ============================================================

model Attachment {
  id           String               @id @default(uuid())
  entityType   AttachmentEntityType @map("entity_type")
  entityId     String               @map("entity_id")
  fileName     String               @map("file_name")
  fileType     String               @map("file_type")
  originalName String               @map("original_name")
  mimeType     String               @map("mime_type")
  fileSize     Int                  @map("file_size")
  storagePath  String               @map("storage_path")
  uploadedById String?              @map("uploaded_by_id")
  createdAt    DateTime             @default(now()) @map("created_at")

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@map("attachments")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// CLINIC SETTINGS
// ============================================================

model ClinicSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinic_settings")
}


model DiseaseCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  herbs HerbDiseaseCategory[]

  @@map("disease_categories")
}

model HerbDiseaseCategory {
  id                 String @id @default(uuid())
  herbId             String @map("herb_id")
  diseaseCategoryId  String @map("disease_category_id")

  herb            Herb            @relation(fields: [herbId], references: [id], onDelete: Cascade)
  diseaseCategory DiseaseCategory @relation(fields: [diseaseCategoryId], references: [id], onDelete: Cascade)

  @@unique([herbId, diseaseCategoryId])
  @@map("herb_disease_categories")
}

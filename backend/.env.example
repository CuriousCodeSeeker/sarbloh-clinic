# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/sarbloh_clinic?schema=public"

# JWT
JWT_SECRET="change-this-to-a-very-long-and-secure-random-string-in-production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="change-this-to-another-very-long-and-secure-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development

# File uploads (local for now)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880
